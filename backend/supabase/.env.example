# Secretos de Supabase (Edge Functions) para AgroCampo.
#
# Este archivo es una PLANTILLA. No contiene valores reales y está versionado a
# propósito (ver .gitignore: sólo se excluye ".env"/".env.*", ".env.example" queda
# incluido). Para usarlo:
#
#   cp backend/supabase/.env.example backend/supabase/.env
#   # completar los valores reales en backend/supabase/.env (nunca se commitea)
#   supabase --workdir backend secrets set --env-file backend/supabase/.env
#
# Guía paso a paso por cada variable: docs/deployment/README.md
#
# Ninguno de estos valores debe imprimirse en logs de CI, en la matriz de
# evidencia (docs/verification/) ni en mensajes de commit/PR.

# --- agro-ai (Edge Function: backend/supabase/functions/agro-ai) ---
# API key de Google AI Studio / Google Cloud para el modelo Gemini.
# Alta: https://aistudio.google.com/app/apikey (requiere cuenta Google) — paso
# humano, ver docs/deployment/03-gemini-ai-agroia.md.
GEMINI_API_KEY=

# Modelo a usar. Opcional: el código ya usa "gemini-2.5-flash" como default si se
# omite (backend/supabase/functions/agro-ai/index.ts).
GEMINI_MODEL=gemini-2.5-flash

# --- weather-proxy (Edge Function: backend/supabase/functions/weather-proxy) ---
# Open-Meteo es gratuito y no requiere API key. Sólo hace falta fijar la
# ubicación real de la parcela para el fallback sin coordenadas explícitas.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_DEFAULT_LATITUDE=
OPEN_METEO_DEFAULT_LONGITUDE=

# --- notification-dispatch (Edge Function: backend/supabase/functions/notification-dispatch) ---
# Cuenta de servicio de Firebase (JSON completo, en una sola línea) para poder
# enviar notificaciones push vía FCM HTTP v1. Alta: Firebase Console → Configuración
# del proyecto → Cuentas de servicio → Generar nueva clave privada — paso humano,
# ver docs/deployment/02-firebase-fcm.md.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Suministrados automáticamente por Supabase en runtime; sólo se listan aquí como
# referencia, no hace falta declararlos a mano en producción.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
