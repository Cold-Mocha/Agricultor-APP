# Valores públicos de compilación (--dart-define) para el APK/AAB de AgroCampo.
#
# PLANTILLA versionada a propósito; ".env" real queda fuera de Git (ver .gitignore).
# Uso local:
#
#   cp frontend/.env.example frontend/.env
#   # completar valores reales
#   ../scripts/build_android_release.sh
#
# Estos valores son PÚBLICOS por diseño (viajan dentro del APK/AAB, visibles para
# quien lo descompile) — por eso nunca incluyen secretos. Los secretos reales
# (GEMINI_API_KEY, FIREBASE_SERVICE_ACCOUNT_JSON, etc.) sólo viven como secretos de
# Supabase; ver backend/supabase/.env.example.
#
# Guía paso a paso: docs/deployment/01-supabase-project.md y
# docs/deployment/06-ci-cd-pipeline.md

# "development" (default si se omite) no exige SUPABASE_URL/KEY y la app funciona
# sólo local/offline. "production" exige ambos o RuntimeConfig.fromCompileTime()
# lanza FormatException a propósito (backend/lib/src/platform/network/runtime_config.dart).
AGROCAMPO_ENV=development

# URL del proyecto Supabase real (Project Settings → API). Vacío en desarrollo.
SUPABASE_URL=

# Clave pública "publishable" (sb_publishable_...) del proyecto Supabase, NO la
# service_role key. Vacío en desarrollo.
SUPABASE_PUBLISHABLE_KEY=

# URL de teselas del mapa (flutter_map); opcional, tiene default en
# frontend/lib/src/modules/territory/presentation/pages/territory_map_page.dart.
MAP_TILE_URL=

# Centro inicial del mapa antes de que el usuario tenga cuadrantes dibujados.
# Opcionales: por defecto apuntan a Temuco, Chile (-38.7363, -72.5974). Ajustar a
# la ubicación real de la explotación agrícola.
MAP_INITIAL_LATITUDE=
MAP_INITIAL_LONGITUDE=
